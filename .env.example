# Supabase
VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Cloudinary (image transformations + uploads)
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset

# ImageKit (CDN delivery)
VITE_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# ImageKit Webhook (Edge Function secret)
IMAGEKIT_WEBHOOK_SECRET=your_webhook_secret

# Supabase Service Role (Edge Functions only — never expose in frontend)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key